<Window x:Class="LucidTune.UI.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки хоткея"
        Width="320" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#1C1C22"
            CornerRadius="14"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Настройки горячей клавиши"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,14"/>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Модификатор:" Foreground="#A0A0AB" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModifierComboBox"
                          Height="28"
                          Background="#26262E"
                          Foreground="#111111"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="Alt" IsSelected="True"/>
                    <ComboBoxItem Content="Ctrl"/>
                    <ComboBoxItem Content="Shift"/>
                    <ComboBoxItem Content="Ctrl+Alt"/>
                </ComboBox>

                <TextBlock Text="Клавиша:" Foreground="#A0A0AB" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="KeyComboBox"
                          Height="28"
                          Background="#26262E"
                          Foreground="#111111"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена"
                        Width="75" Height="28"
                        Background="#2A2A32"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button Content="Сохранить"
                        Width="85" Height="28"
                        Background="#4E75FF"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
