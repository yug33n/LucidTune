<Window x:Class="LucidTune.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LucidTune — Настройки"
        Width="500" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Standard Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888894"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="15">
        <Border CornerRadius="16" Background="#15151B" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="52"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- Header / Titlebar (Draggable) -->
                <Border Grid.Row="0"
                        Background="#1A1A22"
                        CornerRadius="16,16,0,0"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Logo Icon -->
                            <Border Width="24" Height="24" CornerRadius="6" Background="#4E75FF" Margin="0,0,10,0">
                                <Path Width="12" Height="12" Fill="#FFFFFF" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,3V13.55A4,4 0 1,0 14,17V7H18V3H12Z"/>
                            </Border>

                            <TextBlock Text="LucidTune"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>

                            <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Settings" FontSize="11" Foreground="#A0A0AB"/>
                            </Border>
                        </StackPanel>

                        <!-- Header Close Button -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnCloseClick"
                                ToolTip="Закрыть настройки">
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M0,0 L8,8 M8,0 L0,8"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel>
                        <!-- Status Banner -->
                        <Border Background="#1C1C26" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Оверлей рабочего стола активен" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="StatusSubtext" Text="Готов к перехвату медиа (Spotify, браузеры, Telegram)" FontSize="11.5" Foreground="#8E8E98" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#282834"
                                        Foreground="#E0E0E6"
                                        Padding="10,0"
                                        Height="28"
                                        Content="Показать / Скрыть"
                                        Click="OnToggleOverlayClick"/>
                            </Grid>
                        </Border>

                        <!-- 1. Hotkey Section -->
                        <Border Background="#1A1A22" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Горячая клавиша скрытия" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Глобальная комбинация для мгновенного скрытия оверлея поверх всех окон." FontSize="11.5" Foreground="#8E8E98" Margin="0,2,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Modifiers -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Модификатор" FontSize="11.5" Foreground="#A0A0AB" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ModifierComboBox" Height="30" Background="#242430" Foreground="#111111" SelectionChanged="OnHotkeyInputsChanged">
                                            <ComboBoxItem Content="Alt" IsSelected="True"/>
                                            <ComboBoxItem Content="Ctrl"/>
                                            <ComboBoxItem Content="Shift"/>
                                            <ComboBoxItem Content="Ctrl+Alt"/>
                                            <ComboBoxItem Content="Win"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Key -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Клавиша" FontSize="11.5" Foreground="#A0A0AB" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="KeyComboBox" Height="30" Background="#242430" Foreground="#111111" SelectionChanged="OnHotkeyInputsChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Current Hotkey Badge Preview -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Текущая комбинация: " FontSize="11.5" Foreground="#8E8E98" VerticalAlignment="Center"/>
                                    <Border Background="#2B2B38" CornerRadius="5" Padding="8,3" Margin="4,0,0,0">
                                        <TextBlock x:Name="HotkeyPreviewText" Text="Alt + M" FontSize="11.5" FontWeight="SemiBold" Foreground="#4E75FF"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. System and Behavior Section -->
                        <Border Background="#1A1A22" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Параметры работы" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                                <CheckBox x:Name="AutoStartCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Автозагрузка при старте Windows"/>

                                <CheckBox x:Name="AutoHideInGamesCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Автоматически скрывать в полноэкранных играх"/>

                                <CheckBox x:Name="ShowSettingsOnStartupCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Открывать это окно настроек при запуске приложения"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Positioning and Reset Section -->
                        <Border Background="#1A1A22" CornerRadius="10" Padding="14,12" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Позиция на экране" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Перемещайте виджет за любую неинтерактивную область мыши." FontSize="11.5" Foreground="#8E8E98" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#282834"
                                        Foreground="#E0E0E6"
                                        Padding="10,0"
                                        Height="28"
                                        Content="Сбросить в центр"
                                        Click="OnResetPositionClick"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer (Save / Close) -->
                <Border Grid.Row="2"
                        Background="#1A1A22"
                        CornerRadius="0,0,16,16"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Width="85"
                                Background="#2A2A34"
                                Foreground="#C0C0C8"
                                Content="Закрыть"
                                Margin="0,0,10,0"
                                Click="OnCloseClick"/>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Width="145"
                                Background="#4E75FF"
                                Foreground="#FFFFFF"
                                Content="Сохранить настройки"
                                Click="OnSaveClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
