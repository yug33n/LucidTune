<Window x:Class="LucidTune.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LucidTune — Настройки"
        Width="520" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern Dark ScrollBar Thumb -->
        <Style x:Key="DarkScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource SettingsScrollBarThumbBrush}"
                                CornerRadius="3"
                                Margin="1,0"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ScrollBar RepeatButton -->
        <Style x:Key="DarkScrollBarRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Vertical ScrollBar Template -->
        <ControlTemplate x:Key="DarkVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Width="7" SnapsToDevicePixels="True" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DarkScrollBarRepeatButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DarkScrollBarRepeatButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Modern Dark Horizontal ScrollBar Template -->
        <ControlTemplate x:Key="DarkHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Height="7" SnapsToDevicePixels="True" Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DarkScrollBarRepeatButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DarkScrollBarRepeatButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Global Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Template" Value="{StaticResource DarkVerticalScrollBarTemplate}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template" Value="{StaticResource DarkHorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Dark Slider Thumb -->
        <Style x:Key="DarkSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse x:Name="ThumbEllipse"
                                 Width="16" Height="16"
                                 Fill="#FFFFFF"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="2"
                                 SnapsToDevicePixels="True">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource SettingsBadgeBackgroundBrush}"/>
                                <Setter TargetName="ThumbEllipse" Property="Width" Value="18"/>
                                <Setter TargetName="ThumbEllipse" Property="Height" Value="18"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ThumbEllipse" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Horizontal Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource SettingsSliderTrackBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkSliderThumb}" VerticalAlignment="Center"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Modern Dark CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Custom Box with rounded corners and smooth borders -->
                            <Border x:Name="BoxBorder"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="5"
                                    Background="{DynamicResource SettingsInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource SettingsInputBorderBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0"
                                    SnapsToDevicePixels="True">
                                <!-- Modern Crisp Vector CheckMark -->
                                <Path x:Name="CheckMark"
                                      Width="10" Height="8"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AccentTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1 4.5 L 3.8 7.5 L 9 1"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Content Presenter -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="10,7"
                                Margin="3,1"
                                CornerRadius="6"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsButtonSecondaryBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SettingsBadgeBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsBadgeTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox ToggleButton -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border"
                    CornerRadius="7"
                    Background="{DynamicResource SettingsInputBackgroundBrush}"
                    BorderBrush="{DynamicResource SettingsInputBorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M1,2 L5,6 L9,2"
                          Stroke="{DynamicResource SettingsTextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource SettingsTextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Margin="0,4,0,8"
                                            Background="{DynamicResource SettingsCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource SettingsBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Clear Hotkey Button Style -->
        <Style x:Key="MiniClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonSecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsSubCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#322228"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#50FF6B6B"/>
                                <Setter Property="Foreground" Value="#FF7B7B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24181C"/>
                                <Setter Property="Foreground" Value="#FF5555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="15">
        <Border CornerRadius="16"
                Background="{DynamicResource SettingsWindowBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsWindowBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="52"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- Header / Titlebar (Draggable) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SettingsHeaderBackgroundBrush}"
                        CornerRadius="16,16,0,0"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Logo Icon -->
                            <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                <Path Width="12" Height="12" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,3V13.55A4,4 0 1,0 14,17V7H18V3H12Z"/>
                            </Border>

                            <TextBlock Text="LucidTune"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Settings" FontSize="11" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Header Close Button -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnCloseClick"
                                ToolTip="Закрыть настройки">
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M0,0 L8,8 M8,0 L0,8"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="18,14"
                              PreviewMouseWheel="OnContentScrollViewerPreviewMouseWheel"
                              ScrollChanged="OnContentScrollViewerScrollChanged">
                    <StackPanel>
                        <!-- GitHub Update Banner (Quiet Checker) -->
                        <Border x:Name="UpdateBanner"
                                Background="{DynamicResource SettingsSubCardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="14,11"
                                Margin="0,0,0,14"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Icon -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="UpdateTitleText" Text="Доступно обновление LucidTune!" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                    <TextBlock Text="Нажмите «Обновить», чтобы загрузить новую версию с GitHub." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DownloadUpdateButton"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentTextBrush}"
                                            Padding="12,0"
                                            Height="28"
                                            Content="Обновить"
                                            Click="OnDownloadUpdateClick"/>

                                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                                            Width="24" Height="24"
                                            Margin="8,0,0,0"
                                            ToolTip="Скрыть уведомление"
                                            Click="OnDismissUpdateClick">
                                        <Path Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Data="M0,0 L8,8 M8,0 L0,8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Status Banner -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="OverlayStatusTitleText" Text="Оверлей рабочего стола активен" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                    <TextBlock x:Name="OverlayStatusDescText" Text="Готов к перехвату медиа (Spotify, браузеры, Telegram)" FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="ToggleOverlayButton"
                                        Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{DynamicResource SettingsButtonSecondaryBackgroundBrush}"
                                        Foreground="{DynamicResource SettingsButtonSecondaryTextBrush}"
                                        Padding="14,0"
                                        Height="28"
                                        Content="Скрыть"
                                        Click="OnToggleOverlayClick"/>
                            </Grid>
                        </Border>

                        <!-- Appearance Section -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- Theme Selection -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Тема оформления" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Переключение между тёмным и светлым стилем." FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox"
                                              Grid.Column="1"
                                              Height="30"
                                              SelectionChanged="OnThemeSelectionChanged">
                                        <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                        <ComboBoxItem Content="Светлая" Tag="Light"/>
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource SettingsSeparatorBrush}" Margin="0,2,0,10"/>

                                <!-- Accent Color Selection -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Основной цвет" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Цветовой акцент для кнопок, ползунков и бейджей." FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AccentComboBox"
                                              Grid.Column="1"
                                              Height="30"
                                              MaxDropDownHeight="320"
                                              SelectionChanged="OnAccentSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                             <DataTemplate>
                                                 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                     <Border Width="12" Height="12" CornerRadius="6"
                                                             Background="{Binding ColorBrush}"
                                                             BorderBrush="{DynamicResource SettingsBorderBrush}"
                                                             BorderThickness="1"
                                                             Margin="1,0,9,0"
                                                             VerticalAlignment="Center"
                                                             SnapsToDevicePixels="True"/>
                                                     <TextBlock Text="{Binding Name}"
                                                                FontSize="12"
                                                                VerticalAlignment="Center"
                                                                SnapsToDevicePixels="True"/>
                                                 </StackPanel>
                                             </DataTemplate>
                                         </ComboBox.ItemTemplate>
                                     </ComboBox>
                                 </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource SettingsSeparatorBrush}" Margin="0,2,0,10"/>

                                <!-- Adaptive Cover Art Color Checkbox -->
                                <CheckBox x:Name="AdaptiveColorCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Checked="OnAdaptiveColorChanged"
                                          Unchecked="OnAdaptiveColorChanged">
                                    <StackPanel>
                                        <TextBlock Text="Адаптивный цвет под обложку" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Автоматически подбирает цвет акцента под цветовую гамму текущей обложки трека." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{DynamicResource SettingsSeparatorBrush}" Margin="0,6,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Прозрачность виджета" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Настройка видимости оверлея поверх других окон." FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="2,4,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="20%" FontSize="11" Foreground="{DynamicResource SettingsTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="1"
                                            Style="{StaticResource DarkSliderStyle}"
                                            Minimum="20"
                                            Maximum="100"
                                            Value="100"
                                            SmallChange="1"
                                            LargeChange="5"
                                            ValueChanged="OnOpacitySliderValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="100%" FontSize="11" Foreground="{DynamicResource SettingsTextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource SettingsSeparatorBrush}" Margin="0,12,0,10"/>

                                <!-- Vinyl Record Sleeve Mode Checkbox -->
                                <CheckBox x:Name="VinylModeCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Checked="OnVinylModeChanged"
                                          Unchecked="OnVinylModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Режим «Виниловой пластинки»" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Виниловая пластинка плавно выглядывает из конверта альбома и вращается при воспроизведении." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Compact Mode Checkbox -->
                                <CheckBox x:Name="CompactModeCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Checked="OnCompactModeChanged"
                                          Unchecked="OnCompactModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Компактный виджет" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Скрывает изображение альбома, делая оверлей меньше и компактнее." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Show Volume Checkbox -->
                                <CheckBox x:Name="ShowVolumeCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Checked="OnShowVolumeChanged"
                                          Unchecked="OnShowVolumeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Показывать регулировку громкости" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Отображает иконку и полоску управления громкостью внизу виджета." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Discord Rich Presence Section -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Интеграция с Discord" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                <TextBlock Text="Отображение текущей песни, обложки и прогресса в профиле Discord." FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,8"/>

                                <CheckBox x:Name="EnableDiscordRpcCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Включить статус в Discord"/>

                                <CheckBox x:Name="IgnoreBrowserVideosCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Игнорировать видео в браузере (YouTube, Twitch)"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys Section -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Глобальные горячие клавиши" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                <TextBlock Text="Управление оверлеем и воспроизведением поверх всех окон и игр." FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,10"/>

                                <!-- 1. Toggle Overlay Hotkey -->
                                <Border Background="{DynamicResource SettingsSubCardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource SettingsSubCardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource MiniClearButtonStyle}"
                                                    Content="Очистить"
                                                    ToolTip="Очистить горячую клавишу"
                                                    Click="OnClearToggleClick"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Показать / скрыть оверлей: " FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeToggle" Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                    <TextBlock x:Name="PreviewToggleText" Text="Alt + M" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <ComboBox x:Name="ToggleModifierBox" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                        <ComboBox x:Name="ToggleKeyBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Media Hotkeys Checkbox -->
                                <CheckBox x:Name="EnableMediaHotkeysCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Включить горячие клавиши управления медиа"
                                          Checked="OnMediaHotkeysToggle"
                                          Unchecked="OnMediaHotkeysToggle"
                                          Margin="0,4,0,8"/>

                                <StackPanel x:Name="MediaHotkeysPanel">
                                    <!-- 2. Play / Pause Hotkey -->
                                    <Border Background="{DynamicResource SettingsSubCardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource SettingsSubCardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource MiniClearButtonStyle}"
                                                        Content="Очистить"
                                                        ToolTip="Очистить горячую клавишу"
                                                        Click="OnClearPlayPauseClick"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Пауза / Воспроизведение: " FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgePlayPause" Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock x:Name="PreviewPlayPauseText" Text="Alt + Space" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <ComboBox x:Name="PlayPauseModifierBox" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                            <ComboBox x:Name="PlayPauseKeyBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                        </Grid>
                                    </Border>

                                    <!-- 3. Next Track Hotkey -->
                                    <Border Background="{DynamicResource SettingsSubCardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource SettingsSubCardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource MiniClearButtonStyle}"
                                                        Content="Очистить"
                                                        ToolTip="Очистить горячую клавишу"
                                                        Click="OnClearNextClick"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Следующий трек: " FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeNext" Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock x:Name="PreviewNextText" Text="Alt + Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <ComboBox x:Name="NextModifierBox" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                            <ComboBox x:Name="NextKeyBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                        </Grid>
                                    </Border>

                                    <!-- 4. Previous Track Hotkey -->
                                    <Border Background="{DynamicResource SettingsSubCardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,4" BorderBrush="{DynamicResource SettingsSubCardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource MiniClearButtonStyle}"
                                                        Content="Очистить"
                                                        ToolTip="Очистить горячую клавишу"
                                                        Click="OnClearPrevClick"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Предыдущий трек: " FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgePrev" Background="{DynamicResource SettingsBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock x:Name="PreviewPrevText" Text="Alt + Left" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsBadgeTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <ComboBox x:Name="PrevModifierBox" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                            <ComboBox x:Name="PrevKeyBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="OnHotkeyInputsChanged"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- System and Behavior Section -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Параметры работы" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}" Margin="0,0,0,8"/>

                                <CheckBox x:Name="SnapToEdgesCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Примагничивание к краям экрана" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Удобно фиксирует виджет у границ экрана и по центру при перемещении мышью." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ExcludeFromCaptureCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Режим невидимки для стримов (OBS)" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                        <TextBlock Text="Скрывает виджет на стримах, записях экрана OBS и в Discord (виден только вам)." FontSize="11" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{DynamicResource SettingsSeparatorBrush}" Margin="0,4,0,10"/>

                                <CheckBox x:Name="AutoStartCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Автозагрузка при старте Windows"/>

                                <CheckBox x:Name="AutoHideInGamesCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Автоматически скрывать в полноэкранных играх"/>

                                <CheckBox x:Name="ShowSettingsOnStartupCheckBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="Открывать это окно настроек при запуске приложения"/>
                            </StackPanel>
                        </Border>

                        <!-- Positioning and Reset Section -->
                        <Border Background="{DynamicResource SettingsCardBackgroundBrush}" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Позиция на экране" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SettingsTextPrimaryBrush}"/>
                                    <TextBlock Text="Перемещайте виджет мышью за любое свободное место."
                                               FontSize="11.5" Foreground="{DynamicResource SettingsTextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{DynamicResource SettingsButtonSecondaryBackgroundBrush}"
                                        Foreground="{DynamicResource SettingsButtonSecondaryTextBrush}"
                                        Padding="12,0"
                                        Height="28"
                                        Content="Сбросить в центр"
                                        Click="OnResetPositionClick"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer (Save / Close) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SettingsHeaderBackgroundBrush}"
                        CornerRadius="0,0,16,16"
                        BorderBrush="{DynamicResource SettingsBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Width="85"
                                Background="{DynamicResource SettingsButtonSecondaryBackgroundBrush}"
                                Foreground="{DynamicResource SettingsButtonSecondaryTextBrush}"
                                Content="Закрыть"
                                Margin="0,0,10,0"
                                Click="OnCloseClick"/>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Width="150"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentTextBrush}"
                                Content="Сохранить настройки"
                                Click="OnSaveClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
