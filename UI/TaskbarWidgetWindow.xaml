<Window x:Class="LucidTune.UI.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LucidTune Taskbar"
        Width="246" Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Geometries -->
        <Geometry x:Key="PlayGeometry">M3.5,1.5 L12.5,7 L3.5,12.5 Z</Geometry>
        <Geometry x:Key="PauseGeometry">M2.5,1.5 L5,1.5 L5,12.5 L2.5,12.5 Z M8.5,1.5 L11,1.5 L11,12.5 L8.5,12.5 Z</Geometry>
        <Geometry x:Key="PrevGeometry">M9.5,2 L3.5,6.5 L9.5,11 Z M2.5,2 L1,2 L1,11 L2.5,11 Z</Geometry>
        <Geometry x:Key="NextGeometry">M1,2 L7,6.5 L1,11 Z M8,2 L9.5,2 L9.5,11 L8,11 Z</Geometry>
        <Geometry x:Key="MusicNoteGeometry">M12,3v10.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4 4,4 4,-1.79 4,-4V7h4V3h-6z</Geometry>

        <!-- Nav Icon Button Style -->
        <Style x:Key="TaskbarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause Button Style -->
        <Style x:Key="TaskbarPlayButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonCircle"
                                Width="22" Height="22"
                                CornerRadius="11"
                                Background="#22FFFFFF"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonCircle" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonCircle" Property="Background" Value="#4AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonCircle" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card -->
    <Border x:Name="RootCard"
            Margin="2"
            CornerRadius="7"
            Background="#E61A1D25"
            BorderBrush="#25FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="OnRootCardMouseDown"
            MouseWheel="OnRootCardMouseWheel">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Открыть настройки" Click="OnOpenSettingsClick"/>
                <MenuItem Header="Переключить на рабочий стол" Click="OnSwitchToDesktopClick"/>
                <Separator/>
                <MenuItem Header="Закрыть LucidTune" Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Album Artwork -->
            <Border x:Name="ArtworkBorder"
                    Grid.Column="0"
                    Width="24" Height="24"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Background="#252836">
                <Grid>
                    <Path x:Name="FallbackIcon"
                          Data="{StaticResource MusicNoteGeometry}"
                          Fill="#60667B"
                          Width="11" Height="11"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <Image x:Name="ArtworkImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Column 1: Info and Progress -->
            <Grid Grid.Column="1" Margin="6,2,6,3" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title & Time -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock x:Name="TimeText"
                               DockPanel.Dock="Right"
                               Text="0:00"
                               FontSize="8.5"
                               FontFamily="Segoe UI Variable, Segoe UI, Consolas"
                               Foreground="#8F96A6"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="Нет трека"
                               FontWeight="SemiBold"
                               FontSize="9.5"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Row 1: Artist -->
                <TextBlock x:Name="ArtistText"
                           Grid.Row="1"
                           Text="Запустите музыку"
                           FontSize="8.5"
                           Foreground="#7E8494"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,-1,0,2"/>

                <!-- Row 2: Thinner Progress Bar (2px height) -->
                <Border x:Name="ProgressBarTrack"
                        Grid.Row="2"
                        Height="2"
                        CornerRadius="1"
                        Background="#2C303E"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="OnProgressBarMouseDown">
                    <Border x:Name="ProgressBarFill"
                            Height="2"
                            CornerRadius="1"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

            <!-- Column 2: Playback Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0">
                <!-- Previous Button -->
                <Button x:Name="PrevButton"
                        Style="{StaticResource TaskbarNavButtonStyle}"
                        ToolTip="Предыдущий"
                        Click="OnPrevButtonClick">
                    <Path Data="{StaticResource PrevGeometry}"
                          Fill="#B6BCCD"
                          Width="8" Height="8"
                          SnapsToDevicePixels="True"/>
                </Button>

                <!-- Play/Pause Button -->
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource TaskbarPlayButtonStyle}"
                        ToolTip="Воспроизведение / Пауза"
                        Margin="2,0"
                        Click="OnPlayPauseButtonClick">
                    <Path x:Name="PlayPauseIcon"
                          Data="{StaticResource PlayGeometry}"
                          Fill="#FFFFFF"
                          Width="8" Height="8"
                          Margin="1,0,0,0"
                          SnapsToDevicePixels="True"/>
                </Button>

                <!-- Next Button -->
                <Button x:Name="NextButton"
                        Style="{StaticResource TaskbarNavButtonStyle}"
                        ToolTip="Следующий"
                        Click="OnNextButtonClick">
                    <Path Data="{StaticResource NextGeometry}"
                          Fill="#B6BCCD"
                          Width="8" Height="8"
                          SnapsToDevicePixels="True"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
