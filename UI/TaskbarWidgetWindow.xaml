<Window x:Class="LucidTune.UI.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LucidTune Taskbar"
        Width="175" Height="34"
        MinWidth="95" MaxWidth="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Geometries for Controls -->
        <!-- Play Triangle (Crisp vector) -->
        <Geometry x:Key="PlayGeometry">M2.5,1 L9.5,5.5 L2.5,10 Z</Geometry>
        <!-- Pause Bars (Crisp two bars) -->
        <Geometry x:Key="PauseGeometry">M1.5,1 L4,1 L4,10 L1.5,10 Z M6.5,1 L9,1 L9,10 L6.5,10 Z</Geometry>
        <!-- Previous Button |◀ -->
        <Geometry x:Key="PrevGeometry">M8.5,1.5 L2.5,5.5 L8.5,9.5 Z M1.5,1.5 L0,1.5 L0,9.5 L1.5,9.5 Z</Geometry>
        <!-- Next Button ▶| -->
        <Geometry x:Key="NextGeometry">M1,1.5 L7,5.5 L1,9.5 Z M7.5,1.5 L9,1.5 L9,9.5 L7.5,9.5 Z</Geometry>
        <!-- Music Note fallback icon -->
        <Geometry x:Key="MusicNoteGeometry">M10,2v8.55c-.59-.34-1.27-.55-2-.55-2.21,0-4,1.79-4,4s1.79,4 4,4 4,-1.79 4,-4V5.5h3V2h-5z</Geometry>

        <!-- Clean Control Button Style -->
        <Style x:Key="TaskbarButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRoot" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card: Transparent background with light/white border -->
    <Border x:Name="RootCard"
            CornerRadius="6"
            Background="#01000000"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="OnRootCardMouseDown"
            MouseWheel="OnRootCardMouseWheel">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Открыть настройки" Click="OnOpenSettingsClick"/>
                <MenuItem Header="Переключить на рабочий стол" Click="OnSwitchToDesktopClick"/>
                <Separator/>
                <MenuItem Header="Закрыть LucidTune" Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid VerticalAlignment="Center" Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Album Artwork (collapses when space is constrained) -->
            <Border x:Name="ArtworkBorder"
                    Grid.Column="0"
                    Width="22" Height="22"
                    CornerRadius="3.5"
                    ClipToBounds="True"
                    Margin="3,0,1,0"
                    VerticalAlignment="Center"
                    Background="#18FFFFFF">
                <Grid>
                    <Path x:Name="FallbackIcon"
                          Data="{StaticResource MusicNoteGeometry}"
                          Fill="#90FFFFFF"
                          Width="9" Height="9"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <Image x:Name="ArtworkImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Column 1: Info and Thin Progress Bar -->
            <Grid Grid.Column="1" Margin="4,2,4,2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title & Time in compact layout -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock x:Name="TimeText"
                               DockPanel.Dock="Right"
                               Text="0:00"
                               FontSize="7.5"
                               FontFamily="Segoe UI Variable, Segoe UI, Consolas"
                               Foreground="#A0A5B5"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="Нет трека"
                               FontWeight="SemiBold"
                               FontSize="9"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Row 1: Thinner Progress Bar (2px height, click-to-seek) -->
                <Border x:Name="ProgressBarTrack"
                        Grid.Row="1"
                        Height="2"
                        Margin="0,2,0,0"
                        CornerRadius="1"
                        Background="#35FFFFFF"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="OnProgressBarMouseDown">
                    <Border x:Name="ProgressBarFill"
                            Height="2"
                            CornerRadius="1"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

            <!-- Column 2: Playback Controls (crisp white buttons) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0">
                <!-- Previous Button -->
                <Button x:Name="PrevButton"
                        Width="16" Height="20"
                        Style="{StaticResource TaskbarButtonStyle}"
                        ToolTip="Предыдущий"
                        Click="OnPrevButtonClick">
                    <Path Data="{StaticResource PrevGeometry}"
                          Fill="#FFFFFF"
                          Width="8" Height="8"
                          SnapsToDevicePixels="True"/>
                </Button>

                <!-- Play/Pause Button -->
                <Button x:Name="PlayPauseButton"
                        Width="18" Height="20"
                        Margin="1,0"
                        Style="{StaticResource TaskbarButtonStyle}"
                        ToolTip="Воспроизведение / Пауза"
                        Click="OnPlayPauseButtonClick">
                    <Path x:Name="PlayPauseIcon"
                          Data="{StaticResource PlayGeometry}"
                          Fill="#FFFFFF"
                          Width="9" Height="9"
                          Margin="1,0,0,0"
                          SnapsToDevicePixels="True"/>
                </Button>

                <!-- Next Button -->
                <Button x:Name="NextButton"
                        Width="16" Height="20"
                        Style="{StaticResource TaskbarButtonStyle}"
                        ToolTip="Следующий"
                        Click="OnNextButtonClick">
                    <Path Data="{StaticResource NextGeometry}"
                          Fill="#FFFFFF"
                          Width="8" Height="8"
                          SnapsToDevicePixels="True"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
